<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cocolatan.view.UserController"
      spacing="15">

    <padding>
        <Insets top="10" right="20" bottom="10" left="20"/>
    </padding>

    <!-- Title -->
    <Label text="Gestión de Usuarios" styleClass="section-title"/>

    <!-- Users Table -->
    <TableView fx:id="userTable" VBox.vgrow="ALWAYS" prefHeight="300">
        <columns>
            <TableColumn fx:id="colUsername" text="Usuario" prefWidth="150"/>
            <TableColumn fx:id="colDisplayName" text="Nombre" prefWidth="200"/>
            <TableColumn fx:id="colRole" text="Rol" prefWidth="120"/>
            <TableColumn fx:id="colCreatedAt" text="Creado" prefWidth="160"/>
        </columns>
    </TableView>

    <!-- Action Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="➕ Nuevo usuario" fx:id="btnNew" onAction="#onNew" styleClass="button"/>
        <Button text="✏️ Editar" fx:id="btnEdit" onAction="#onEdit" styleClass="button"/>
        <Button text="🔑 Cambiar contraseña" fx:id="btnChangePassword" onAction="#onChangePassword" styleClass="button"/>
        <Button text="🔑 Clave de recuperación" fx:id="btnMasterKey" onAction="#onChangeMasterKey" styleClass="button"/>
        <Button text="🗑️ Eliminar" fx:id="btnDelete" onAction="#onDelete" styleClass="button-danger"/>
    </HBox>
</VBox>
